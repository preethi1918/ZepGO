# ========================================================
# ZepGO – Environment Configuration
# ========================================================

# Frontend Configuration
VITE_API_URL=http://127.0.0.1:8000
VITE_MAPBOX_TOKEN=pk.optional_mapbox_token_here
VITE_DEFAULT_SAFETY_RESERVE=18

# Backend Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Optional Third-Party API Keys (Graceful fallback to internal realistic models enabled)
OPENWEATHER_API_KEY=optional_weather_key
GOOGLE_MAPS_API_KEY=optional_google_maps_key
ELEVATION_API_KEY=optional_elevation_key

# Database (Optional external persistent store, default is high-speed sample data store)
FIREBASE_DATABASE_URL=
DATABASE_URL=sqlite:///./zepgo.db
